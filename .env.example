# ════════════════════════════════════════════════════════════
# LUPA — Exemplo de variáveis de ambiente
# ════════════════════════════════════════════════════════════
# Copie este arquivo para `.env` e preencha com valores reais.
# NUNCA commite o arquivo `.env`.

# ──────────────────────────────────────────────────
# Core
# ──────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-use-get_random_secret_key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

# ──────────────────────────────────────────────────
# Banco de dados
# ──────────────────────────────────────────────────
# Formato: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://lupa:lupa@localhost:5432/lupa_v2

# ──────────────────────────────────────────────────
# Redis (cache + locks)
# ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ──────────────────────────────────────────────────
# Email (Resend em produção; console backend em dev)
# ──────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=LUPA <nao-responda@lupasolucoes.com>

# ──────────────────────────────────────────────────
# Storage (local em dev e prod inicial)
# ──────────────────────────────────────────────────
MEDIA_ROOT=./media
STATIC_ROOT=./staticfiles

# ──────────────────────────────────────────────────
# Sentry (opcional em dev)
# ──────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ──────────────────────────────────────────────────
# Segurança em produção (override em prod.py)
# ──────────────────────────────────────────────────
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0

# ──────────────────────────────────────────────────
# Aplicação
# ──────────────────────────────────────────────────
LUPA_DEFAULT_SIGNAL_PCT=50
LUPA_WAITLIST_THRESHOLD=15
